{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "node_modules", "test"]
  },
  "context": {
    "stage": "dev",
    "region": "us-east-2",
    "domainName": "rader-resume.com",
    "githubOwner": "radermade",
    "githubRepo": "rader-resume",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"]
  }
}
